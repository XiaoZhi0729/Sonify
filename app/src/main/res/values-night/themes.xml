<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Flamingo" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="android:windowBackground">@android:color/background_dark</item>
    </style>

    <!-- 开屏主题（深色）：**页面底色（黑）+ 品牌红 Logo**。
         底色与首页表面同色，"底色淡去"这一步视觉上不可见，交接天然无缝。
         系统闪屏也画同一个 Logo，让系统接管的那一段就能看到品牌标识。
         MainActivity 还会按应用内主题设置在 super.onCreate 之前 setTheme 覆盖，
         以覆盖"应用强制深色但系统浅色"这类组合。 -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenBackground">@color/launch_surface_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.Flamingo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="android:windowBackground">@color/launch_surface_dark</item>
    </style>

    <style name="SplashTheme.Dark" parent="SplashTheme" />
</resources>