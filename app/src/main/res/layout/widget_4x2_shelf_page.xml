<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:gravity="top"
    android:orientation="horizontal">

    <!-- Slot 0 -->
    <LinearLayout
        android:id="@+id/shelf_slot_0"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="70dp"
            android:layout_height="70dp">

            <ImageView
                android:id="@+id/shelf_art_0"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_art_placeholder" />

            <TextView
                android:id="@+id/shelf_badge_last_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/widget_badge_last"
                android:includeFontPadding="false"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="@string/widget_badge_last"
                android:textColor="@color/widget_badge_fg"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/shelf_badge_idx_0"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/widget_badge_index"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/widget_badge_fg"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/shelf_title_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_fg"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shelf_artist_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_micro_fg"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- Slot 1 -->
    <LinearLayout
        android:id="@+id/shelf_slot_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="70dp"
            android:layout_height="70dp">

            <ImageView
                android:id="@+id/shelf_art_1"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_art_placeholder" />

            <TextView
                android:id="@+id/shelf_badge_idx_1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/widget_badge_index"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/widget_badge_fg"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/shelf_title_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_sub_fg"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shelf_artist_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_micro_fg"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- Slot 2 -->
    <LinearLayout
        android:id="@+id/shelf_slot_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="70dp"
            android:layout_height="70dp">

            <ImageView
                android:id="@+id/shelf_art_2"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_art_placeholder" />

            <TextView
                android:id="@+id/shelf_badge_idx_2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/widget_badge_index"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/widget_badge_fg"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/shelf_title_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_sub_fg"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shelf_artist_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_micro_fg"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- Slot 3 -->
    <LinearLayout
        android:id="@+id/shelf_slot_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="70dp"
            android:layout_height="70dp">

            <ImageView
                android:id="@+id/shelf_art_3"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_art_placeholder" />

            <TextView
                android:id="@+id/shelf_badge_idx_3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/widget_badge_index"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/widget_badge_fg"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/shelf_title_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_sub_fg"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shelf_artist_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_micro_fg"
            android:textSize="9.5sp" />
    </LinearLayout>
</LinearLayout>
