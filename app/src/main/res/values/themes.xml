<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- windowLightStatusBar 的语义（踩过的坑，别再写反）：
         true  = "状态栏底色是浅色" → 系统画**深色图标**；false = 画白色图标。
         本工程浅色主题是白底，所以必须是 true。历史版本从逆向资源里抄成了 false，
         结果白图标画在白底上完全看不见。

         这个值不只是启动时生效：core-splashscreen 在**闪屏退场**那一刻会重读当前
         Activity 主题的 windowLightStatusBar / windowLightNavigationBar，再
         setSystemBarsAppearance 写回窗口。那时序在 Compose 首帧的 SideEffect 之后，
         所以一旦写反，表现就是"冷启动后状态栏图标一直是反的，直到某次重组把它改回来"
         （手动切一下主题设置就恢复正常，正是这个原因）。 -->

    <!-- ============ 窗口主题 ============ -->

    <!-- 跟随系统配置的默认主题（AndroidManifest 的 application 主题）。
         应用内强制深浅时不走它，走下面的 .Light / .Dark 显式副本。 -->
    <style name="Theme.Flamingo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <!-- 浅色主题下这里原本误写成 background_dark：闪屏撤场到 Compose 首帧之间会闪一下黑。
             与 Surface 的底色（浅色=白）保持一致。 -->
        <item name="android:windowBackground">@android:color/background_light</item>
    </style>

    <!-- 显式浅色副本：**不随系统配置变化**。
         资源限定符（values-night）只认系统 uiMode，不认应用内设置，所以"系统深色 +
         应用强制浅色"这条组合只能靠显式样式，否则会拿到 values-night 里的深色主题
         （底黑 + 白图标），闪屏退场时还会把白图标写回窗口。
         必须用 framework 父样式重建，不能 parent="Theme.Flamingo"——那会在 night 配置下
         继承到深色版本，等于没修。 -->
    <style name="Theme.Flamingo.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="android:windowBackground">@android:color/background_light</item>
    </style>

    <!-- 显式深色副本：给"应用内强制深色 + 系统浅色"用。与 values-night 的 Theme.Flamingo 等价。 -->
    <style name="Theme.Flamingo.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 深底 → 白色图标。 -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="android:windowBackground">@android:color/background_dark</item>
    </style>

    <!-- ============ 开屏主题 ============ -->

    <!-- 开屏（跟随系统配置）：只给"自动"档用——那种情况下应用内深浅就等于系统深浅，
         资源限定符天然是对的。Manifest 里 MainActivity 声明的就是它。 -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenBackground">@color/launch_surface</item>
        <item name="postSplashScreenTheme">@style/Theme.Flamingo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 闪屏本身是白底，图标同样要走深色，否则闪屏期间"看不见"图标。 -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="android:windowBackground">@color/launch_surface</item>
    </style>

    <!-- 开屏（显式浅色）：**页面底色（白）+ 品牌红 Logo**。
         底色刻意不是品牌红：开屏页与首页表面同色，"底色淡去"这一步视觉上不可见，
         交接天然无缝；观众看到的只有「Logo 浮现 → Logo 退场 → 内容浮现」三拍。
         系统闪屏也画同一个 Logo：冷启动最初那段（窗口还没交给 Compose）就已经能看到
         品牌标识，而不是先一片空底色再突然冒出 Logo。
         同样必须重建而不能 parent="SplashTheme"：night 配置下会继承到深色开屏。 -->
    <style name="SplashTheme.Light" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenBackground">@color/launch_surface</item>
        <item name="postSplashScreenTheme">@style/Theme.Flamingo.Light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="android:windowBackground">@color/launch_surface</item>
    </style>

    <!-- 开屏（显式深色）：同样的做法，底色换成**页面底色（黑）**。
         由 MainActivity 在 onCreate 里按应用自身的主题设置选择，
         不能只依赖 values-night —— 应用内可以手动强制深色而系统仍是浅色。 -->
    <style name="SplashTheme.Dark" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenBackground">@color/launch_surface_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.Flamingo.Dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="android:windowBackground">@color/launch_surface_dark</item>
    </style>
</resources>
