<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_glass_body" />
            <corners android:radius="@dimen/widget_radius_card" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_glass_rim" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="@color/widget_glass_top_sheen_center"
                android:centerX="0.38"
                android:centerY="0.38"
                android:endColor="@color/widget_glass_top_sheen_end"
                android:startColor="@color/widget_glass_top_sheen_start"
                android:type="linear" />
            <corners android:radius="@dimen/widget_radius_card" />
        </shape>
    </item>
</layer-list>
