<?xml version="1.0" encoding="utf-8"?>
<!-- 开屏 Logo（黑色）—— 深色主题用。
     为什么是黑色：开屏动画里的"Logo"其实是幕布挖开的洞，透出首页底色；
     深色首页是纯黑，所以洞看起来是黑色。系统闪屏必须同色才能无缝交接，
     否则会从白色跳成黑色。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="192"
    android:viewportHeight="192">
    <path
        android:fillColor="#FF000000"
        android:pathData="M149,56.5V34.5V32L84,46.5L82.5,116.5L43,125.5V159.38L104,146L105.5,66L149,56.5Z" />
</vector>
